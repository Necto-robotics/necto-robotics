# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.swp

# Local agent / workspace files
.claude/
*.md.bak

# Journey app (site/) — installed and built, never committed
site/node_modules/
site/dist/
site/dist-vite/
site/captures/

# Not required to run the site (not served / not compiled):

# Dev + planning docs
*.md
README.txt

# Sass sources — NOT compiled; site loads the precompiled assets/css/main.css
assets/sass/

# Brand source set (working logos live in images/)
Necto-Robotics-Logos/

# Scripted-asset intermediates (regenerated by tools/build-assets.mjs)
site/assets-src/build/

# Docs that ARE part of the repo
!docs/*.md
